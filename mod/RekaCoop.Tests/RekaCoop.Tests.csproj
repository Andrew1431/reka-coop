<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the parts with no game or Unity references. Run: mod/test.ps1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <Compile Include="..\RekaCoop\Net\*.cs" Link="Net\%(Filename).cs" />
    <Compile Include="..\RekaCoop\Diagnostics\Scrubber.cs" Link="Diagnostics\Scrubber.cs" />
  </ItemGroup>
</Project>
